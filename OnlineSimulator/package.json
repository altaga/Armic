{
  "name": "armic-online-simulator",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "tsc": "tsc --noEmit",
    "webbuild": "npx expo export -p web",
    "webserve": "npx expo export -p web && npx expo serve",
    "deploy": "npx expo export --platform web && node scripts/fix-routes-json.mjs && eas deploy",
    "deploy:prod": "npx expo export --platform web && node scripts/fix-routes-json.mjs && eas deploy --prod",
    "predeploy": "npm version patch --no-git-tag-version"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "expo": "~57.0.19",
    "expo-build-properties": "~0.12.5",
    "expo-dev-client": "~57.0.18",
    "expo-gl": "~14.0.2",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.18",
    "expo-status-bar": "~1.12.1",
    "expo-three": "~7.0.0",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-web": "^0.19.13",
    "three": "^0.160.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "@types/three": "^0.160.0",
    "typescript": "~5.3.3"
  }
}
