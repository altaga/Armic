{
  "name": "armic-online-simulator",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "tsc": "tsc --noEmit",
    "webbuild": "npx expo export -p web",
    "webserve": "npx expo export -p web && npx expo serve",
    "deploy": "npx expo export --platform web && node scripts/fix-routes-json.mjs && eas deploy",
    "deploy:prod": "npx expo export --platform web && node scripts/fix-routes-json.mjs && eas deploy --prod",
    "predeploy": "npm version patch --no-git-tag-version"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "expo": "~57.0.19",
    "expo-asset": "~57.0.16",
    "expo-build-properties": "~57.0.16",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.17",
    "expo-file-system": "~57.0.6",
    "expo-gl": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-modules-core": "~57.0.15",
    "expo-router": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "expo-three": "~7.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "three": "^0.160.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.4",
    "@types/three": "^0.160.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  }
}
